# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — your real keys never get committed.

# TMDb v4 API token — https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# Supabase project — https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
